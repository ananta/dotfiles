[user]
	name = ananta
	email = 12180395+ananta@users.noreply.github.com 
[credential]
	helper = osxkeychain
[pull]
	rebase = false
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	# n / N jump between files in a diff
	navigate = true
[merge]
	conflictStyle = zdiff3
